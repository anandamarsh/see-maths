{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "seemaths.com"
        }
      ],
      "destination": "https://seemaths.org/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.seemaths.com"
        }
      ],
      "destination": "https://seemaths.org/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "seemaths.com"
        }
      ],
      "destination": "https://seemaths.org/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.seemaths.com"
        }
      ],
      "destination": "https://seemaths.org/",
      "statusCode": 301
    }
  ]
}
